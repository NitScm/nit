# Copy to .env and fill in. Keep it mode 600: it holds two credentials.
#
#   cp .env.example .env && chmod 600 .env
#
# Settings marked (required) have no default and the stack refuses to start
# without them, rather than coming up with something nobody chose.

# --- database (required) ----------------------------------------------------

POSTGRES_USER=nit
POSTGRES_PASSWORD=
POSTGRES_DB=nit
POSTGRES_SSLMODE=disable

# --- nit --------------------------------------------------------------------

NIT_IMAGE=ghcr.io/nitscm/nit:latest
NIT_CONSOLE_IMAGE=ghcr.io/nitscm/nit-console:latest

# A checkout of your policy repository, mounted read-only. This is where
# authorization lives: rules, groups and repositories, reviewed like code.
# (required)
NIT_POLICY_DIR=/etc/nit/policy

# The sync token signing key, at least 32 bytes, shared by every replica:
#
#   openssl rand -base64 32 > /etc/nit/sync.key && chmod 600 /etc/nit/sync.key
#
# Generating one per replica would make a load-balanced deployment reject
# tokens at random; rotating it makes every workspace resynchronize. Treat it
# like a database password. (required)
NIT_SYNC_KEY_FILE=/etc/nit/sync.key

# Groups allowed to read the operations API — nitctl stats|tasks|audit and the
# web console. Empty means nobody. Comma-separated.
NIT_ADMIN_GROUPS=platform

# Only when the console is served from another origin. Same host, leave empty.
NIT_CORS_ORIGINS=

# Bound to loopback by default: put a TLS terminator in front rather than
# exposing the API directly.
NIT_BIND=127.0.0.1
NIT_PORT=8080
NIT_CONSOLE_BIND=127.0.0.1
NIT_CONSOLE_PORT=8090

NIT_LOG_LEVEL=info
NIT_MAX_PATCH_BYTES=104857600

# Must survive a clone of your largest repository — see docs/CONFIGURATION.md.
NIT_LEASE_DURATION=60s

# --- the forge (required) ---------------------------------------------------

# The credential nit pushes with. A machine identity, not a person's: it should
# have write access to exactly the repositories in the bundle, and it should not
# stop working when someone leaves.
NIT_FORGE_TOKEN=

# --- compose.gitea.yaml only ------------------------------------------------

GITEA_ROOT_URL=https://git.example.com/
GITEA_DOMAIN=git.example.com
GITEA_BIND=0.0.0.0
GITEA_PORT=3000
GITEA_SSH_PORT=2222
